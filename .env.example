# ================================
# ENVIRONNEMENT
# ================================
ENVIRONMENT=development

# ================================
# BASE DE DONNÉES
# ================================
DATABASE_URL=postgresql+asyncpg://cherubins:changeme@localhost:5432/cherubins_seraphins

# ================================
# SÉCURITÉ / JWT
# ================================
JWT_SECRET_KEY=changeme-generate-a-real-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ================================
# CORS
# ================================
CORS_ORIGINS=http://localhost:3000

# ================================
# REDIS (réservé — non utilisé par le code applicatif en MVP)
# ================================
REDIS_URL=redis://localhost:6379/0

# ================================
# LOGS
# ================================
LOG_LEVEL=INFO
